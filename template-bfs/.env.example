# Plantilla de variables de entorno — BFS Martial Arts
#
# Copia este archivo como .env.local y llena los valores reales.
# .env.local no se sube al repositorio; este si, para que cualquiera sepa
# que variables hacen falta.
#
# Ambos valores salen de Supabase > Project Settings > API Keys.
# Usa la clave PUBLISHABLE (sb_publishable_...), nunca la SECRET.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_KEY=sb_publishable_XXXXXXXXXXXX
